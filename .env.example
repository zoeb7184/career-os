# ─────────────────────────────────────────────────────────────────
#  Career OS — Environment Variables
#  Copy this to .env and fill in your values.
#  NEVER commit .env to git. .env is in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=career_user
POSTGRES_PASSWORD=career_pass
POSTGRES_DB=career_os
POSTGRES_URL=postgresql://career_user:career_pass@localhost:5432/career_os

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant ─────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Auth (JWT) ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Google OAuth (optional for now) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Job Data APIs (all free tiers) ────────────────────────────────
# Adzuna: https://developer.adzuna.com (free, millions of jobs)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Reed: https://www.reed.co.uk/developers (free, UK jobs)
REED_API_KEY=your_reed_api_key

# The Muse: https://www.themuse.com/developers (free)
THE_MUSE_API_KEY=

# Remotive: no key needed — it's fully public
REMOTIVE_API_KEY=

# ── AI / LLM (Groq — 100% FREE, no credit card needed) ────────────
# Get your free key at: https://console.groq.com → API Keys → Create
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL_EXTRACTION=llama-3.1-8b-instant
GROQ_MODEL_ADVISOR=llama-3.3-70b-versatile

# Local embedding model — runs on your machine, zero cost
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── AWS / Storage (optional for now) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=career-os-resumes

# ── MLflow ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_ATS=ats_analyzer
MLFLOW_EXPERIMENT_REC=recommender
MLFLOW_EXPERIMENT_FORECAST=forecaster

# ── Celery ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
